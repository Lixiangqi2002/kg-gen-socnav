[Unit]
Description=Know2SocNav KGGen Explorer
After=network.target

[Service]
Type=simple
WorkingDirectory=/data/code/Know2SocNav/src/kg-gen-socnav
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONPATH=/data/code/Know2SocNav/src/kg-gen-socnav/src
ExecStart=/data/code/Know2SocNav/src/kg-gen-socnav/.venv/bin/python -m uvicorn app.server:app --host 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
